# ──────────────────────────────────────────────
# Scrumtious – Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────

# ── LLM Provider (required) ──────────────────
# Google Gemini API key – used by CrewAI agents
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model (gemini-2.0-flash is deprecated — use 2.5)
# GEMINI_MODEL=gemini/gemini-2.5-flash

# ── Firebase (optional) ──────────────────────
# Only needed if you enable project-board sync
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/serviceAccountKey.json

# ── Server (optional) ────────────────────────
# HOST=127.0.0.1
# PORT=8000

# Set to 1 ONLY when running behind a trusted reverse proxy (nginx/Caddy) that
# sets X-Forwarded-For. When enabled, the last hop of the header (appended by
# your proxy) is used for rate limiting and the local-only session list check.
# Leave unset for direct exposure — the header is client-controlled and would
# let anyone bypass rate limits.
# TRUST_PROXY=1
